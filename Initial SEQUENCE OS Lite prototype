import json
import hashlib
import os
import time
import threading
import base64
import struct
import hmac
import math

# ═══════════════════ 辅助工具 ═══════════════════
def fmt_strength(s):
    return f"{s:.2f}"

def show_memories(mem_list, title="记忆"):
    print(f"\n{title}:")
    for m in mem_list:
        print(f"  [{fmt_strength(m['strength'])}] {m['content']}")

# ═══════════════════ 第一层：Link ═══════════════════
class Link:
    VERSION = b"\x01\x02"
    def __init__(self, store_dir="./link_store"):
        self.store_dir = store_dir
        os.makedirs(store_dir, exist_ok=True)
    def _derive_key(self, pwd: str, salt: bytes) -> bytes:
        return hashlib.pbkdf2_hmac('sha256', pwd.encode(), salt, 100000)
    def write(self, state: dict, pwd: str) -> str:
        link_id = hashlib.sha256(str(time.time()).encode()).hexdigest()[:16]
        salt = os.urandom(16)
        key = self._derive_key(pwd, salt)
        raw = json.dumps(state).encode()
        length = struct.pack("!I", len(raw))
        iv = os.urandom(12)
        ks = hashlib.sha256(key).digest() * ((len(raw) + 32) // 32 + 1)
        encrypted = bytes(a ^ b for a, b in zip(raw, ks[:len(raw)]))
        payload = self.VERSION + length + iv + encrypted
        mac = hmac.new(key, payload, "sha256").digest()
        full = payload + mac
        final = base64.b64encode(full).decode()
        store = {"id": link_id, "salt": base64.b64encode(salt).decode(),
                 "ts": time.time(), "data": final}
        with open(os.path.join(self.store_dir, f"{link_id}.json"), "w") as f:
            json.dump(store, f)
        return link_id
    def read(self, link_id: str, pwd: str) -> dict:
        path = os.path.join(self.store_dir, f"{link_id}.json")
        if not os.path.exists(path):
            raise FileNotFoundError(f"Link {link_id} 不存在")
        with open(path) as f:
            store = json.load(f)
        salt = base64.b64decode(store["salt"])
        key = self._derive_key(pwd, salt)
        full = base64.b64decode(store["data"])
        if len(full) < 32:
            raise ValueError("数据太短，无法校验")
        sig, payload = full[-32:], full[:-32]
        expected = hmac.new(key, payload, "sha256").digest()
        if not hmac.compare_digest(sig, expected):
            raise ValueError("Link 校验失败：数据可能被篡改")
        ver, length = struct.unpack("!2sI", payload[:6])
        if ver != self.VERSION:
            raise ValueError(f"版本不兼容: {ver.hex()} != {self.VERSION.hex()}")
        iv, cipher = payload[6:18], payload[18:18+length]
        ks = hashlib.sha256(key).digest() * ((length + 32) // 32 + 1)
        raw = bytes(a ^ b for a, b in zip(cipher, ks[:length]))
        return json.loads(raw)

# ═══════════════════ 第二层：LCS（事件队列） ═══════════════════
class LCS:
    def __init__(self):
        self._events = []
        self._lock = threading.Lock()
    def register_deadline(self, node_id: str, ms: int, event_type: str = "timeout"):
        print(f"[LCS] 节点 {node_id} 超时 {ms}ms 注册")
        def _push():
            with self._lock:
                self._events.append({
                    "type": event_type,
                    "node_id": node_id,
                    "ts": time.time(),
                    "payload": {"timeout_ms": ms}
                })
                print(f"[超时] {node_id} 超时了!")
        t = threading.Timer(ms / 1000, _push)
        t.start()
        return t
    def get_event(self):
        with self._lock:
            if self._events:
                return self._events.pop(0)
        return None

# ═══════════════════ 第三层：LMS（记忆与审计） ═══════════════════
class LMS:
    def __init__(self, path="./memory_store.json"):
        self.path = path
        self.lock = threading.Lock()
        self.store = []
        self._load()
    def _load(self):
        if os.path.exists(self.path):
            with open(self.path) as f:
                self.store = json.load(f)
    def _save(self):
        with open(self.path, "w") as f:
            json.dump(self.store, f, indent=2)
    def add(self, content: str, meta=None):
        with self.lock:
            for m in self.store:
                if m["content"] == content and not m.get("is_audit"):
                    return m["id"]
            m = {
                "id": hashlib.md5(content.encode()).hexdigest()[:8],
                "content": content,
                "ts": time.time(),
                "strength": 1.0,
                "is_audit": False,
                "meta": meta or {}
            }
            self.store.append(m)
            self._save()
            return m["id"]
    def add_audit(self, action: str, detail=""):
        with self.lock:
            m = {
                "id": hashlib.md5((action+detail).encode()).hexdigest()[:8],
                "content": f"[AUDIT] {action}: {detail}",
                "ts": time.time(),
                "strength": 1.0,
                "is_audit": True
            }
            self.store.append(m)
            self._save()
    def decay_all(self, half_life=7):
        with self.lock:
            now = time.time()
            lam = (2 ** (1 / half_life) - 1) / 86400
            for m in self.store:
                if m.get("is_audit"): continue
                elp = now - m.get("_last_decay", m["ts"])
                m["strength"] = max(0.0, m["strength"] * (1 - lam) ** elp)
                m["_last_decay"] = now
            self._save()
    def query(self, top_k=5, exclude_audit=True):
        with self.lock:
            now = time.time()
            scored = []
            for m in self.store:
                if exclude_audit and m.get("is_audit"): continue
                if m.get("strength", 0) < 0.01: continue
                score = 0.5 * m["strength"] + 0.5 * 1 / (1 + (now - m["ts"]) / 86400)
                scored.append((score, m))
            scored.sort(key=lambda x: x[0], reverse=True)
            seen = set()
            unique = []
            for score, m in scored:
                if m["content"] not in seen:
                    seen.add(m["content"])
                    unique.append((score, m))
            return [m for _, m in unique[:top_k]]

# ═══════════════════ 状态机 ═══════════════════
class StateMachine:
    def __init__(self, lms: LMS):
        self.state = "frozen"
        self.lms = lms
    def transition(self, target: str, reason: str = ""):
        if target not in ["frozen", "awakening", "awake", "standby"]:
            raise ValueError(f"未知状态: {target}")
        _from = self.state
        self.state = target
        self.lms.add_audit("state_transition", f"{_from} -> {target} | reason: {reason or 'none'}")
        print(f"[状态机] {_from} -> {target}")
    def is_awake(self):
        return self.state == "awake"

# ═══════════════════ Agent ═══════════════════
class Agent:
    def __init__(self, lms: LMS, sm: StateMachine):
        self.lms = lms
        self.sm = sm
    def think(self, query: str) -> str:
        mems = self.lms.query(top_k=3)
        ctx = " ".join(m["content"] for m in mems)
        return f"回复: 关于'{query}'的记忆已调取"

# ═══════════════════ HealLoop ═══════════════════
class HealLoop:
    def __init__(self, lms: LMS, sm: StateMachine):
        self.lms = lms
        self.sm = sm
    def heal(self, strategy: dict) -> bool:
        print(f"[HealLoop] 开始恢复: {strategy}")
        if not self.sm.is_awake():
            self.sm.transition("awake", "heal_force")
        self.lms.add_audit("heal", str(strategy))
        print("[HealLoop] 恢复成功")
        return True

# ═══════════════════ 调度器 ═══════════════════
class Scheduler:
    def __init__(self, lms: LMS):
        self.lms = lms
        self.base_k = 8
    def schedule(self, context=""):
        candidates = self.lms.query(top_k=20)
        scored = []
        for m in candidates:
            score = (
                0.3 * m["strength"] +
                0.2 * 1 / (1 + (time.time() - m["ts"]) / 86400) +
                0.3 * (0.5 if any(w in m["content"] for w in context.split()) else 0)
            )
            scored.append((score, m))
        scored.sort(key=lambda x: x[0], reverse=True)
        seen = set()
        unique = []
        for score, m in scored:
            if m["content"] not in seen:
                seen.add(m["content"])
                unique.append(m)
        return unique[:self.base_k]

# ═══════════════════ 主演示（事件循环，无 sleep） ═══════════════════
def main():
    print("=== SEQUENCE OS Lite (去重 + 事件循环) ===")
    link = Link()
    lcs = LCS()
    lms = LMS()
    sm = StateMachine(lms)
    agent = Agent(lms, sm)
    heal = HealLoop(lms, sm)
    sched = Scheduler(lms)

    # 注册 2 秒超时
    print("\n[1] 初始化...")
    lcs.register_deadline("demo", 2000)

    # 写入状态和记忆（在超时前完成）
    state_id = link.write({"agent": "demo", "step": 0}, "pwd")
    sm.transition("awake")
    lms.add("用户喜欢简洁的回答")
    lms.add("上次方案写到第三章")
    lms.add("用户不喜欢长段落")
    lms.add("用户偏好简洁回复")

    # 事件循环
    timeout_handled = False
    running = True
    while running:
        event = lcs.get_event()
        if event and not timeout_handled:
            print(f"\n[超时事件] {event}")
            timeout_handled = True

            # 衰减 + 调度
            print("\n[2] 温度衰减...")
            lms.decay_all(half_life=7)
            show_memories(lms.query(top_k=10), "衰减后记忆")

            print("\n[3] 调度器 Top-K:")
            top = sched.schedule("方案")
            for m in top:
                print(f"  [{m['strength']:.2f}] {m['content']}")

            # Agent + HealLoop
            print(f"\n[4] Agent: {agent.think('我上次写到哪了')}")
            heal.heal({"type": "test"})

            # 验证持久化
            restored = link.read(state_id, "pwd")
            print(f"\n[5] Link 持久化验证: {restored}")
            running = False

        # 短 sleep 防止空转（<100ms）
        time.sleep(0.05)

    print("\n=== 演示完成 ===")

if __name__ == "__main__":
    main()
    # ═══════════════════ 双时间线 LMS（追加层，不修改原有代码） ═══════════════════
class DualTimelineLMS(LMS):
    """
    双时间线记忆系统（继承自 LMS，向下兼容）。
    
    在原有单时间线基础上，增加业务时间线（valid_from / valid_until）。
    系统时间线（recorded_at / invalidated_at）复用原有 ts / T2 机制。
    
    业务时间线：
      valid_from  = T1（事实成立时间，调用者传入）
      valid_until = T2（事实失效时间，NULL=当前有效，赋值后查询不返回）
    
    系统时间线：
      recorded_at    = T0（写入时间，系统自动）
      invalidated_at = 记录作废时间（人工或系统强制，不等于 T2）
    """
    
    def add(self, content: str, meta=None, valid_from=None, valid_until=None):
        """
        写入带业务时间线的记忆。
        
        参数：
          content:    事实内容
          meta:       元数据（可选）
          valid_from: 事实成立时间（T1，默认当前时间）
          valid_until: 事实失效时间（T2，NULL=当前有效）
        """
        with self.lock:
            # 去重（沿用父类逻辑）
            for m in self.store:
                if m["content"] == content and not m.get("is_audit"):
                    # 如果内容相同但 valid_until 不同，视为新版本
                    if m.get("valid_until") == valid_until:
                        return m["id"]
            
            now = time.time()
            m = {
                "id": hashlib.md5(content.encode()).hexdigest()[:8],
                "content": content,
                # 业务时间线
                "valid_from": valid_from if valid_from is not None else now,
                "valid_until": valid_until,  # NULL = 当前有效
                # 系统时间线
                "ts": now,                    # T0（写入时间）
                "invalidated_at": None,       # 默认未作废
                # 原有字段
                "strength": 1.0,
                "is_audit": False,
                "meta": meta or {}
            }
            self.store.append(m)
            self._save()
            return m["id"]
    
    def query(self, top_k=5, exclude_audit=True, query_time=None):
        """
        查询在 query_time 时有效的记忆。
        
        过滤规则（按优先级）：
          1. 业务失效：valid_until 非空且小于等于 query_time → 排除
          2. 系统作废：invalidated_at 非空且小于等于 query_time → 排除
          3. 审计记忆：is_audit = True → 排除（可选）
          4. 强度阈值：strength < 0.01 → 排除
        """
        with self.lock:
            now = query_time if query_time is not None else time.time()
            scored = []
            
            for m in self.store:
                # 审计过滤
                if exclude_audit and m.get("is_audit"):
                    continue
                
                # 业务时间线过滤：valid_until 非空且已过期 → 不返回
                vu = m.get("valid_until")
                if vu is not None and vu <= now:
                    continue
                
                # 系统时间线过滤：invalidated_at 非空且已作废 → 不返回
                ia = m.get("invalidated_at")
                if ia is not None and ia <= now:
                    continue
                
                # 强度过滤
                if m.get("strength", 0) < 0.01:
                    continue
                
                # 评分（与父类一致，增加 valid_from 权重）
                # 时效性基于 valid_from 计算，而非写入时间 ts
                vf = m.get("valid_from", m["ts"])
                score = 0.5 * m["strength"] + 0.5 * 1 / (1 + (now - vf) / 86400)
                scored.append((score, m))
            
            scored.sort(key=lambda x: x[0], reverse=True)
            
            # 去重（按内容聚合）
            seen = set()
            unique = []
            for score, m in scored:
                if m["content"] not in seen:
                    seen.add(m["content"])
                    unique.append((score, m))
            
            return [m for _, m in unique[:top_k]]
    
    def invalidate(self, memory_id: str):
        """
        系统强制作废一条记录（设置 invalidated_at）。
        不删除，只退出视角。与 T2（valid_until）独立。
        """
        with self.lock:
            for m in self.store:
                if m["id"] == memory_id:
                    m["invalidated_at"] = time.time()
                    self._save()
                    return True
            return False


