# ═══════════ 测试 4：完整链路 ═══════════
def test_pipeline():
    print("\n===== [4] 完整链路测试 =====")
    if os.path.exists("./pipeline_store.json"):
        os.remove("./pipeline_store.json")
    lms = SchemaLMS(path="./pipeline_store.json")

    # 1. FactSchema 检查
    try:
        lms.ingest("测试", agent_id="A", attribute="not_exist")
        print("[FAIL] 非法 attribute 未被拒绝")
    except ValueError as e:
        print(f"[OK] 非法 attribute 被拒绝: {e}")

    # 2. R1 写入侧
    lms.ingest("北京", agent_id="A", attribute="residence", source="user")
    lms.ingest("上海", agent_id="A", attribute="residence", source="system")
    r = [m for m in lms.recall(agent_id="A") if m.get("attribute") == "residence"]
    print(f"[R1] residence 有效: {len(r)} 条: {[m['content'] for m in r]}")
    assert len(r) == 1 and r[0]["content"] == "上海"

    # 3. 强制制造冲突（绕过 R1 直接写库）
    with lms.lock:
        lms.store.append({
            "id": "conflict_test",
            "agent_id": "A",
            "attribute": "residence",
            "content": "旧北京残留",
            "source": "unknown",
            "ts": time.time() - 86400,
            "valid_from": time.time() - 86400,
            "valid_until": None,
            "invalidated_at": None,
            "strength": 1.0,
            "is_audit": False,
        })
        lms._save()

    # 4. Conflict Resolver 读取侧
    r2 = [m for m in lms.recall(agent_id="A") if m.get("attribute") == "residence"]
    print(f"[Resolver] 冲突后有效: {len(r2)} 条: {[m['content'] for m in r2]}")
    assert len(r2) == 1 and r2[0]["content"] == "上海"

    # 5. source 权重排序
    lms.ingest("用户亲口说的偏好", agent_id="A", attribute="preference", source="user")
    lms.ingest("系统推断的偏好", agent_id="A", attribute="preference", source="system")
    pref = [m for m in lms.recall(agent_id="A") if m.get("attribute") == "preference"]
    print(f"[source] 偏好排序: {[m['content'] for m in pref]}")
    assert pref[0]["content"] == "用户亲口说的偏好"

    # 6. 重启后保持
    lms2 = SchemaLMS(path="./pipeline_store.json")
    r_total = lms2.recall(top_k=100)
    print(f"[重启] 有效记忆数: {len(r_total)}")
    print("\n[4] 完整链路 全部通过")

